# 개발 기본값은 코드 안에 있어 .env가 없어도 동작한다.
# 운영(또는 dev 외 환경)에서 덮어쓸 값만 명시한다.

REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql+asyncpg://ofcp:ofcp@localhost:5432/ofcp
ALLOWED_ORIGINS=["http://localhost:5173"]

# 게임 state Redis TTL(초). save마다 갱신.
GAME_TTL_SECONDS=3600

# JWT — 운영에서는 32바이트 이상의 무작위 시크릿으로 반드시 교체.
#   예) python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=1209600
JWT_SIGNUP_TTL_SECONDS=600

# Google OAuth — Google Cloud Console에서 발급한 Web 클라이언트 ID
GOOGLE_CLIENT_ID=
